---
import { site, contact, social } from '../config/site';

import '@fontsource/bebas-neue/latin-400.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import '@fontsource/barlow-condensed/latin-800.css';
import '@fontsource/cormorant-garamond/latin-300-italic.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.title,
  description = site.description,
} = Astro.props;

const url = Astro.url;
const ogImage = new URL(site.ogImage, url).toString();
const avatarUrl = new URL(site.avatar, url).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  givenName: site.givenName,
  familyName: site.familyName,
  jobTitle: site.role,
  description: site.description,
  url: site.url,
  image: avatarUrl,
  email: contact.email,
  nationality: site.nationality,
  knowsAbout: site.knowsAbout,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.location.city,
    addressRegion: site.location.region,
    addressCountry: site.location.country,
  },
  sameAs: [social.linkedin.url, social.github.url],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.name,
  description: site.description,
  inLanguage: site.lang,
  publisher: { '@id': `${site.url}/#person` },
};
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(site.ogImageWidth)} />
    <meta property="og:image:height" content={String(site.ogImageHeight)} />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.ogImageAlt} />
    <link rel="canonical" href={url} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />

    <link rel="me" href={social.linkedin.url} />
    <link rel="me" href={social.github.url} />
    <link rel="me" href={contact.mailto} />

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Runs before first paint to avoid FOUC. -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', stored || (prefersDark ? 'dark' : 'light'));
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div id="page-scrim" aria-hidden="true"></div>
    <slot />
    <div id="cursor" class="cursor" aria-hidden="true"></div>
    <div id="grain-layer" aria-hidden="true"></div>
  </body>
</html>

<style is:global>
  @import '../styles/theme.css';
  @import '../styles/tokens.css';
  @import '../styles/typography.css';
  @import '../styles/global.css';

  #page-scrim {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: #000;
    opacity: 0;
    pointer-events: none;
    will-change: opacity;
  }

  /* One noise tile, repeated, on a layer that is rasterised once and then
     only ever transformed — so the grain costs nothing per frame at any
     resolution. Sized past the viewport on every side so the stepped
     transform never exposes an edge.

     Stacked ABOVE the cursor on purpose: `backdrop-filter` has to re-read
     whatever paints beneath it, so a full-screen layer changing 20 times a
     second was dragging the cursor's filter along with it. */
  #grain-layer {
    position: fixed;
    top: -25%;
    left: -25%;
    width: 150%;
    height: 150%;
    z-index: 10000;
    pointer-events: none;
    opacity: 0;
    background-repeat: repeat;
    will-change: transform;
    contain: strict;
  }

  #grain-layer.is-grain-ready {
    opacity: 0.04;
    animation: grain-shift 500ms steps(1, end) infinite;
  }

  /* Ten stops across 500ms — the same 20 changes a second the canvas
     repaint produced, as a compositor-only transform. Offsets stay well
     inside the 25% margin the layer carries on each side. */
  @keyframes grain-shift {
    0%   { transform: translate3d(0, 0, 0); }
    10%  { transform: translate3d(-6%, -3%, 0); }
    20%  { transform: translate3d(4%, -7%, 0); }
    30%  { transform: translate3d(-8%, 5%, 0); }
    40%  { transform: translate3d(7%, 2%, 0); }
    50%  { transform: translate3d(-3%, -8%, 0); }
    60%  { transform: translate3d(8%, 6%, 0); }
    70%  { transform: translate3d(-5%, -2%, 0); }
    80%  { transform: translate3d(2%, 8%, 0); }
    90%  { transform: translate3d(-7%, 4%, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    #grain-layer { animation: none; }
  }

  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: transparent;
    pointer-events: none;
    /* Inversion of whatever sits under the cursor. The filter only READS
       the pixels inside the cursor's box, but the compositor still has to
       keep everything painted below it available to sample — so anything
       changing down there re-runs the filter. That is why the grain layer
       is stacked OVER the cursor rather than under it. */
    backdrop-filter: invert(1);
    -webkit-backdrop-filter: invert(1);
    z-index: 9999;
    transform: translate(var(--cx, -100px), var(--cy, -100px)) translate(-50%, -50%);
    transition: width 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
                height 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
                opacity 200ms;
    opacity: 0;
    will-change: transform;
  }

  .cursor.is-ready { opacity: 1; }

  .cursor.is-active {
    width: 72px;
    height: 72px;
  }

  @media (hover: hover) and (pointer: fine) {
    html, body { cursor: none; }
    a, button, [role="button"], label { cursor: none; }
  }

  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    html, body { cursor: auto; }
    a, button, [role="button"], label { cursor: pointer; }
    .cursor { display: none; }
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity  700ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 700ms cubic-bezier(0.4, 0, 0.2, 1);
    overflow-anchor: none;
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Only the IO fallback uses these. */
  [data-reveal][data-reveal-delay="1"] { transition-delay: 80ms; }
  [data-reveal][data-reveal-delay="2"] { transition-delay: 160ms; }
  [data-reveal][data-reveal-delay="3"] { transition-delay: 240ms; }
  [data-reveal][data-reveal-delay="4"] { transition-delay: 320ms; }
  [data-reveal][data-reveal-delay="5"] { transition-delay: 400ms; }
  [data-reveal][data-reveal-delay="6"] { transition-delay: 480ms; }

  /* Gated on body.reveals-ready so the loader can hold reveals off. */
  @supports (animation-timeline: view()) {
    body.reveals-ready [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
      animation: reveal-rise linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 15%;
    }

    @keyframes reveal-rise {
      from { opacity: 0; transform: translateY(28px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
      animation: none;
    }
  }

  .mask-reveal__word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    /* Extra room so descenders (g, p, y) aren't clipped. */
    padding-block: 0.15em;
    margin-block: -0.15em;
  }

  .mask-reveal__inner {
    display: inline-block;
    transform: translateY(110%);
    transition: transform 950ms cubic-bezier(0.215, 0.61, 0.355, 1);
    transition-delay: calc(var(--i, 0) * 70ms);
  }

  [data-mask-reveal].is-mask-revealed .mask-reveal__inner {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .mask-reveal__inner {
      transform: none;
      transition: none;
    }
  }

  html.lenis, html.lenis body { height: auto; }
  .lenis.lenis-smooth { scroll-behavior: auto !important; }
  .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
  .lenis.lenis-stopped { overflow: hidden; }
  .lenis.lenis-smooth iframe { pointer-events: none; }
</style>

<script>
  import { initSmoothScroll } from '../scripts/SmoothScroll';
  import { initPageScrim } from '../scripts/PageScrim';
  import { initReveal, setupMaskReveals } from '../scripts/Reveal';
  import { initGrain } from '../scripts/GrainCanvas';
  import { initCustomCursor } from '../scripts/CustomCursor';
  import { initConsoleGreeting } from '../scripts/ConsoleGreeting';

  initSmoothScroll();
  initPageScrim();
  initGrain();
  initCustomCursor();
  initConsoleGreeting();

  import('../scripts/TextDistortion').then(({ initTextDistortions }) => {
    initTextDistortions();
  });
  import('../scripts/ScrambleHover').then(({ initScrambleHover }) => {
    initScrambleHover();
  });

  setupMaskReveals();

  // Guard against the loader event firing AFTER the 4s fallback already ran,
  // which would double-init and leak a second set of IntersectionObservers.
  let revealed = false;
  const safeInitReveal = () => {
    if (revealed) return;
    revealed = true;
    initReveal();
  };

  document.addEventListener('loader:done', safeInitReveal);

  const fallback = setTimeout(() => {
    document.body.classList.add('hero-ready');
    safeInitReveal();
  }, 4000);
  document.addEventListener('loader:done', () => clearTimeout(fallback));
</script>
